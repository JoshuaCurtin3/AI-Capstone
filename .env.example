# Copy this file to .env and fill in real values.
# .env must never be committed to source control (see CLAUDE.md).

# --- App core (Phase 2) ---
APP_SECRET_KEY=change-me
APP_DEBUG=False

# --- PostgreSQL (Phase 5) ---
POSTGRES_DB=phishing_analyzer
POSTGRES_USER=phishing_analyzer
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Active Directory / LDAPS (Phase 6) ---
LDAP_SERVER_URI=ldaps://ad.example.local:636
LDAP_BIND_DN=CN=svc-phishing-app,OU=Service Accounts,DC=example,DC=local
LDAP_BIND_PASSWORD=change-me
LDAP_USER_SEARCH_BASE_DN=OU=Users,DC=example,DC=local
LDAP_GROUP_SEARCH_BASE_DN=OU=Groups,DC=example,DC=local

# --- Claude API (Phase 7 — explanation generation only, never scoring) ---
ANTHROPIC_API_KEY=change-me
