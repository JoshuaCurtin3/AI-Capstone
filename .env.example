# Copy this file to .env and fill in real values.
# .env must never be committed to source control (see CLAUDE.md).

# --- App core (Phase 2) ---
APP_SECRET_KEY=change-me
APP_DEBUG=False
# "development" enables /docs and /redoc; anything else (e.g. "production") disables them.
APP_ENVIRONMENT=development
# --- Email parser (Phase 3) ---
# Caps raw email size (pasted or uploaded) accepted by /upload, in bytes.
APP_MAX_EMAIL_UPLOAD_BYTES=10000000

# --- PostgreSQL (Phase 5) ---
# Full SQLAlchemy connection string the app (and Alembic - see alembic/env.py)
# actually connect with. Must be postgresql:// or postgresql+<driver>://.
APP_DATABASE_URL=postgresql+psycopg2://phishing_analyzer:change-me@localhost:5432/phishing_analyzer
APP_DATABASE_CONNECT_TIMEOUT_SECONDS=3
# The POSTGRES_* vars below match the official postgres Docker image's
# required env var names for the Phase 8 docker-compose `db` service -
# construct APP_DATABASE_URL above from the same values for non-Docker
# (e.g. the current manually-provisioned systemd) deployments.
POSTGRES_DB=phishing_analyzer
POSTGRES_USER=phishing_analyzer
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: a separate database used only by the Postgres-backed integration
# tests (tests/integration/test_database.py, test_dashboard.py,
# test_alembic_migrations.py). Unset/unreachable => those tests skip
# themselves rather than failing, per CLAUDE.md never touching a real
# database from unit tests. Point this at a disposable database, never a
# real dev/prod one - the migration tests create and drop tables.
# TEST_DATABASE_URL=postgresql+psycopg2://phishing_analyzer:change-me@localhost:5432/phishing_analyzer_test

# --- Active Directory / LDAPS (Phase 6) ---
# Must be ldaps:// - plain ldap:// is rejected at startup (see app/config.py).
APP_LDAP_SERVER_URI=ldaps://ad.example.local:636
# Read-only service account, used only to search for a user's DN - never used
# to validate a login password (that always happens via a bind-as-user).
APP_LDAP_BIND_DN=CN=svc-phishing-app,OU=Service Accounts,DC=example,DC=local
APP_LDAP_BIND_PASSWORD=change-me
APP_LDAP_USER_SEARCH_BASE_DN=OU=Users,DC=example,DC=local
# DN of the AD group a user must belong to (directly or via nested groups) to
# be allowed to log in.
APP_LDAP_REQUIRED_GROUP_DN=CN=PhishingAnalyzer-Users,OU=Groups,DC=example,DC=local
# sAMAccountName is the typical AD login attribute; override if your directory differs.
APP_LDAP_USER_LOGIN_ATTRIBUTE=sAMAccountName
APP_LDAP_CONNECT_TIMEOUT_SECONDS=5
APP_LDAP_GROUP_MEMBERSHIP_MAX_DEPTH=6

# --- Session cookies (Phase 6) ---
# Signed with APP_SECRET_KEY above - no separate secret needed.
APP_SESSION_MAX_AGE_SECONDS=28800

# --- Claude API (Phase 7 — explanation generation only, never scoring) ---
# Bare ANTHROPIC_API_KEY (no APP_ prefix - the SDK's own convention). Optional:
# leave blank and the app still starts; AI explanations degrade to a fallback
# message and email analysis is unaffected (see app/ai_analysis/services.py).
ANTHROPIC_API_KEY=
APP_ANTHROPIC_MODEL=claude-opus-5
APP_ANTHROPIC_MAX_TOKENS=500
APP_ANTHROPIC_TIMEOUT_SECONDS=15
